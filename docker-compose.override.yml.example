# docker-compose.override.yml
# This file is automatically used by Docker Compose for local development
# Provides development-specific overrides to docker-compose.yaml

version: '3.8'

services:
  backend:
    environment:
      - SPRING_PROFILES_ACTIVE=dev
    ports:
      - "8080:8080"
    volumes:
      - ./backend/src:/app/src

  frontend:
    environment:
      - ENVIRONMENT=development
    ports:
      - "4200:4200"
    command: npm start
    volumes:
      - ./frontend/src:/app/src
      - /app/node_modules
